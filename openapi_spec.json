{
  "openapi": "3.1.0",
  "info": {
    "title": "Serum Osmolality Calculator API",
    "description": "Estimated serum osmolality, tonicity, and optional osmolal gap; legacy audit endpoints are illustrative.",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service is reachable"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory service counters",
        "responses": {
          "200": {
            "description": "JSON processing counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Request a placeholder mock response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Report in-memory audit block count and integrity status",
        "responses": {
          "200": {
            "description": "Audit block count and verification boolean (no raw log entries)"
          }
        }
      }
    },
    "/api/osmolality": {
      "post": {
        "summary": "Calculate estimated osmolality, effective osmolality, and optional osmolal gap",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sodium": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mmol/L"
                  },
                  "glucose": {
                    "type": "number",
                    "minimum": 0
                  },
                  "bun": {
                    "type": "number",
                    "minimum": 0,
                    "description": "mg/dL, conventional only"
                  },
                  "urea": {
                    "type": "number",
                    "minimum": 0,
                    "description": "mmol/L, SI only"
                  },
                  "measured_osmolality": {
                    "type": "number",
                    "minimum": 0,
                    "description": "optional mOsm/kg"
                  },
                  "unit_system": {
                    "type": "string",
                    "enum": [
                      "conventional",
                      "si"
                    ],
                    "default": "conventional"
                  }
                },
                "required": [
                  "sodium",
                  "glucose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Osmolality estimates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "calculated_osmolality": {
                      "type": "number"
                    },
                    "effective_osmolality": {
                      "type": "number"
                    },
                    "osmolal_gap": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    }
  }
}
